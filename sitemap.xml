---
layout: null
permalink: /sitemap.xml
---
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
{% assign sorted_pages = site.pages | sort: 'url' %}
{% for item in sorted_pages %}
  {% unless item.url contains '/404' or item.url contains '.xml' or item.url contains '.txt' or item.url contains '.css' or item.url contains '.js' or item.robots contains 'noindex' or item.sitemap == false %}
  <url><loc>{{ item.url | replace: 'index.html', '' | absolute_url }}</loc></url>
  {% endunless %}
{% endfor %}
{% for post in site.posts %}
  {% unless post.robots contains 'noindex' or post.sitemap == false %}
  <url><loc>{{ post.url | absolute_url }}</loc><lastmod>{{ post.date | date_to_xmlschema }}</lastmod></url>
  {% endunless %}
{% endfor %}
</urlset>
